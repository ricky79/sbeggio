{
  "name": "sbeggio",
  "private": true,
  "version": "2.15.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "icone": "node scripts/genera-icone.mjs",
    "versione:controlla": "node --experimental-strip-types scripts/rilascio.ts controlla",
    "versione:codice": "node --experimental-strip-types scripts/rilascio.ts codice",
    "build:android": "tsc --noEmit && tsc -p tsconfig.sw.json && vite build --mode android && cap sync android",
    "android:apri": "npm run build:android && cap open android"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
